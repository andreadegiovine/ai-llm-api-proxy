# Configurazione di ai-llm-api-proxy
#
# Copia questo file in .env nella stessa cartella e modificalo (vedi docs/PROXMOX.md):
#   cp .env.example .env
# .env è escluso da git: un `git pull` non lo sovrascrive.
# Le variabili già presenti nell'ambiente hanno la precedenza: con il servizio systemd della repo,
# quelle in /etc/llm-proxy/llm-proxy.env (consigliato per le variabili personalizzate, vedi README).

# ---------------------------------------------------------------- server del proxy
# Funzioni del proxy: system prompt, tool MCP, database history, compattazione, annunci, protezione dai
# loop... (true, default). Con false il proxy inoltra /v1/chat/completions a llama.cpp senza nessuna
# modifica (i tool restano quelli del client): utile per confrontare il comportamento del modello.
ENABLE_PROXY_FEATURES=true
# Log degli scambi per la diagnostica (richieste del client, richieste e risposte di llama.cpp, risposte
# al client), una riga JSON per evento. Contiene le conversazioni intere: attivalo solo quando serve.
LOG_EXCHANGES=false
# File del log degli scambi. Vuoto = un file per modalità nella cartella del database history:
# exchanges-avanzata.jsonl (ENABLE_PROXY_FEATURES=true) ed exchanges-inoltro.jsonl (false); con il
# servizio systemd in /var/lib/llm-proxy/.
EXCHANGE_LOG=

# Indirizzo e porta su cui ascolta il proxy.
# 0.0.0.0 = tutte le interfacce. Se nginx è nello stesso container, usa 127.0.0.1.
PROXY_HOST=0.0.0.0
PROXY_PORT=8081

# API key accettate dal proxy, separate da virgola. I client le inviano come
# "Authorization: Bearer <key>" (il campo "API key" dei client OpenAI).
# Vuoto = nessuna autenticazione: va bene solo in una LAN fidata.
# OBBLIGATORIA se il proxy è raggiungibile da internet.
# Per generarne una: openssl rand -hex 32
PROXY_API_KEYS=

# IP dei reverse proxy (nginx) fidati, separati da virgola: il log mostrerà l'IP reale
# del client letto da X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------- llama.cpp
# Indirizzo di llama-server (avviato con --jinja)
LLAMA_URL=http://192.168.1.10:8080
# Chiave se llama-server è avviato con --api-key (altrimenti lascia vuoto)
LLAMA_API_KEY=

# ---------------------------------------------------------------- server MCP
# Endpoint MCP. Vuoto = nessun server MCP.
# Streamable HTTP di solito termina con /mcp, SSE con /sse.
MCP_URL=http://192.168.1.11:8000/mcp
# http (streamable HTTP) oppure sse
MCP_TRANSPORT=http

# ---------------------------------------------------------------- comportamento
# File del system prompt. Vuoto = system_prompt.txt nella cartella del proxy
# (se manca, si usa system_prompt.example.txt).
SYSTEM_PROMPT_FILE=
# Giri massimi di tool per una singola risposta (un giro può contenere più tool). 0 = nessun limite.
# All'ultimo giro il modello non può più usare tool: viene avvisato e riassume cosa resta da fare.
MAX_TOOL_ROUNDS=0
# Protezione dai loop: se il modello ripete N volte di seguito la stessa chiamata (stesso tool, stessi
# argomenti) ottenendo lo stesso risultato, il giro successivo è senza tool. 0 = disattivata.
TOOL_REPEAT_LIMIT=3
# Prima di ogni tool la chat mostra un annuncio con una frase naturale (vedi ANNOUNCEMENTS_FILE).
# Markdown aggiuntivo per i client che lo interpretano (es. Open WebUI):
#   true:  ragionamenti come blocchi <think>...</think> nel punto in cui avvengono, e dopo ogni
#          tool il box <details type="tool_calls"> con argomenti e risultato
#   false: solo testo; ragionamenti nel campo standard reasoning_content
# Con false i client che non interpretano questi tag non vedono markup grezzo in chat.
SEND_CHAT_MARKDOWN=false
# Frasi di attesa ("Sto ragionando...", "Ancora qualche secondo...") quando la chat resta senza testo
# visibile: la prima dopo PROGRESS_FIRST_SECONDS secondi, poi una ogni PROGRESS_EVERY_SECONDS.
# I ragionamenti non contano come testo visibile. PROGRESS_FIRST_SECONDS=0 = disattivate.
PROGRESS_FIRST_SECONDS=10
PROGRESS_EVERY_SECONDS=20
# File delle frasi. Vuoto = progress_phrases.json nella cartella del proxy, se esiste, altrimenti
# progress_phrases.example.json (le frasi di default).
PROGRESS_PHRASES_FILE=
# Ragionamento (thinking) del modello:
#   vuoto: decidono llama.cpp, il template del modello o il client (default)
#   false: disattivato in ogni richiesta (risposte più rapide, meno token)
#   true:  attivato in ogni richiesta, per i modelli che di default non ragionano
# Con true/false l'impostazione del proxy prevale su quella inviata dal client.
ENABLE_THINKING=

# Fuso orario della data e ora di inizio conversazione, scritte nel system prompt
TIMEZONE=Europe/Rome

# ---------------------------------------------------------------- database history
# Il proxy salva ogni conversazione (messaggi, ragionamenti, tool call e risultati) nel database
# "history", così quando il client la riprende il modello ritrova l'intero scambio (1 = attivo).
ENABLE_HISTORY=1
# File del database. Vuoto = history.db nella cartella del proxy. Con il servizio systemd della repo
# è /var/lib/llm-proxy/history.db (impostato nel servizio, che ha la precedenza su questo file).
HISTORY_DB=
# Conversazioni non usate da più di N giorni vengono eliminate all'avvio (0 = mai)
HISTORY_RETENTION_DAYS=90
# Intestazione con l'id della chat inviata dal client, per riconoscere la conversazione con precisione.
# Open WebUI la invia con ENABLE_FORWARD_USER_INFO_HEADERS=true nella sua configurazione; senza, la
# conversazione viene riconosciuta dal testo dei messaggi precedenti.
HISTORY_CHAT_ID_HEADER=X-OpenWebUI-Chat-Id
# Immagini e audio restituiti dai tool (anteprime, screenshot, registrazioni) passati al modello in un
# messaggio dopo i risultati dei tool. false per i modelli che non accettano immagini o audio.
TOOL_IMAGES=true
TOOL_AUDIO=true
# File aperti dai tool (tool in sola lettura con un percorso, es. file_leggi, vedi_immagine) che restano
# interi nel prompt: i precedenti diventano il loro percorso e il modello li riapre se servono. Nella
# compattazione vengono sostituiti tutti (tranne quelli dell'ultimo giro). -1 = funzione disattivata.
FILE_KEEP_LAST=3

# ---------------------------------------------------------------- annunci dei tool
# File con le frasi naturali con cui il proxy annuncia l'uso dei tool, generate dal modello una volta
# per tool e raggruppate per URL del server MCP. Vuoto = tool_announcements.json nella cartella del
# database history (con il servizio systemd: /var/lib/llm-proxy/tool_announcements.json).
ANNOUNCEMENTS_FILE=
# Ragionamento del modello durante la generazione degli annunci (true/false). Con true le frasi sono un
# po' più curate ma la generazione è molto più lenta (anche 15 minuti ogni 5 tool, con llama.cpp occupato).
ANNOUNCEMENTS_THINKING=false

# ---------------------------------------------------------------- compattazione della memoria
# Compattazione automatica quando il prompt si avvicina al contesto massimo (1 = attiva)
AUTO_COMPACT=1
# Espone al modello il tool compact_memory (1 = sì)
ENABLE_COMPACT_TOOL=1
# Compatta oltre questa frazione del contesto (n_ctx letto da llama.cpp)
COMPACT_THRESHOLD=0.80
# Dopo la compattazione il prompt resta sotto questa frazione del contesto
COMPACT_TARGET=0.50
# Lunghezza massima del riassunto, in token
COMPACT_SUMMARY_TOKENS=1024
# Token riservati alla risposta, se il client non indica max_tokens
COMPACT_RESERVE_TOKENS=2048
# Limite ai risultati dei tool:
#   auto: i risultati arrivano interi finché entrano nel contesto; quelli troppo grandi vengono accorciati
#         allo spazio libero sotto COMPACT_THRESHOLD (tolti risposta, system prompt, tool e riassunto),
#         così la compattazione li gestisce e llama.cpp non va oltre il contesto (default)
#   0:    nessun limite (un risultato più grande del contesto fa rispondere a llama.cpp con un errore)
#   0.25: limite fisso per ogni risultato, in frazione del contesto
MAX_TOOL_RESULT_RATIO=auto
# Contesto usato solo se llama.cpp non comunica n_ctx
DEFAULT_N_CTX=8192
# Ogni quanti secondi rileggere n_ctx da llama.cpp
N_CTX_TTL=60
# Numero massimo di riassunti tenuti in cache
COMPACT_CACHE_SIZE=256
